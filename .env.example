# Event Management Platform - Environment Configuration Template
# Copy this file to .env.local and customize the values for your environment

#==============================================================================
# GENERAL SETTINGS
#==============================================================================

# Application Environment (development, staging, production)
NODE_ENV=development

# Application Base URLs
API_BASE_URL=http://localhost:3000/api/v1
FRONTEND_BASE_URL=http://localhost:5173

#==============================================================================
# DATABASE CONFIGURATION
#==============================================================================

# PostgreSQL Connection (TimescaleDB enabled)
DATABASE_URL=postgresql://eventuser:eventpass@localhost:5432/eventdb
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=eventuser
DATABASE_PASSWORD=eventpass
DATABASE_NAME=eventdb
DATABASE_SCHEMA=public

# Database Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=60000

#==============================================================================
# REDIS CONFIGURATION
#==============================================================================

# Redis Connection (for caching and sessions)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Session Configuration
REDIS_SESSION_TTL=86400
REDIS_CACHE_TTL=3600

#==============================================================================
# AUTHENTICATION & SECURITY
#==============================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CORS_CREDENTIALS=true

#==============================================================================
# EMAIL CONFIGURATION
#==============================================================================

# SMTP Settings (for notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Email Templates
EMAIL_FROM_ADDRESS=noreply@eventplatform.com
EMAIL_FROM_NAME=Event Platform

# Development Email (MailHog for testing)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

#==============================================================================
# PAYMENT GATEWAY CONFIGURATION
#==============================================================================

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Omise Configuration (for Thailand market)
OMISE_PUBLISHABLE_KEY=pkey_test_your_omise_publishable_key_here
OMISE_SECRET_KEY=skey_test_your_omise_secret_key_here

# Payment Configuration
PAYMENT_CURRENCY=USD
PAYMENT_PROCESSING_FEE_PERCENTAGE=2.9
PAYMENT_PROCESSING_FEE_FIXED=0.30

#==============================================================================
# FILE UPLOAD & STORAGE
#==============================================================================

# Local File Storage
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.doc,.docx

# AWS S3 Configuration (optional - for production)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=event-platform-uploads
# AWS_S3_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

#==============================================================================
# EXTERNAL SERVICES
#==============================================================================

# Analytics Service (Python backend)
ANALYTICS_SERVICE_URL=http://localhost:3003
ANALYTICS_SERVICE_API_KEY=analytics-service-api-key

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_API_KEY=notification-service-api-key

#==============================================================================
# LOGGING & MONITORING
#==============================================================================

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=5

# Monitoring Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true

# Error Tracking (Optional - Sentry)
# SENTRY_DSN=https://your-sentry-dsn-here
# SENTRY_ENVIRONMENT=development

#==============================================================================
# WEBSOCKET CONFIGURATION
#==============================================================================

# WebSocket Settings (for real-time updates)
WS_PORT=3000
WS_PATH=/socket.io
WS_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
WS_TRANSPORTS=websocket,polling

#==============================================================================
# DEVELOPMENT SETTINGS
#==============================================================================

# Debug Configuration
DEBUG_ENABLED=true
DEBUG_NAMESPACE=event-platform:*

# Database Seeding
SEED_ADMIN_EMAIL=admin@eventplatform.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_TEST_DATA=true

# Testing Configuration
TEST_DATABASE_URL=postgresql://eventuser:eventpass@localhost:5432/eventdb_test
TEST_REDIS_URL=redis://localhost:6379/1

#==============================================================================
# INTERNATIONALIZATION
#==============================================================================

# Default Language & Locale
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=UTC
SUPPORTED_LANGUAGES=en,th

#==============================================================================
# COMPLIANCE & SECURITY
#==============================================================================

# GDPR/PDPA Configuration
DATA_RETENTION_DAYS=2555
COOKIE_CONSENT_REQUIRED=true
PRIVACY_POLICY_URL=https://eventplatform.com/privacy
TERMS_OF_SERVICE_URL=https://eventplatform.com/terms

# Security Headers
HELMET_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_ENABLED=true

#==============================================================================
# MICROSERVICES CONFIGURATION
#==============================================================================

# Service Ports
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
CUSTOMER_PORTAL_SERVICE_PORT=3002
TICKET_SERVICE_PORT=3003
PAYMENT_SERVICE_PORT=3004
ANALYTICS_SERVICE_PORT=3005
COMPLIANCE_SERVICE_PORT=3006

# Service URLs (for inter-service communication)
USER_SERVICE_URL=http://localhost:3001
CUSTOMER_PORTAL_SERVICE_URL=http://localhost:3002
TICKET_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
ANALYTICS_SERVICE_URL=http://localhost:3005
COMPLIANCE_SERVICE_URL=http://localhost:3006

#==============================================================================
# FRONTEND CONFIGURATION
#==============================================================================

# React App Environment Variables (prefixed with VITE_)
VITE_APP_NAME=Event Management Platform
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
VITE_OMISE_PUBLISHABLE_KEY=pkey_test_your_omise_publishable_key_here
VITE_ENVIRONMENT=development
VITE_ANALYTICS_ENABLED=false
VITE_DEBUG_ENABLED=true

#==============================================================================
# DOCKER CONFIGURATION
#==============================================================================

# Docker Compose Overrides
COMPOSE_PROJECT_NAME=event-platform
COMPOSE_FILE=infrastructure/docker/docker-compose.dev.yml

# Container Health Check
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3