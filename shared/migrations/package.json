{
  "name": "@event-platform/migrations",
  "version": "1.0.0",
  "description": "Database migrations for Event Management Platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "migration:generate": "typeorm migration:generate -d data-source.ts",
    "migration:create": "typeorm migration:create",
    "migration:run": "typeorm migration:run -d data-source.ts",
    "migration:revert": "typeorm migration:revert -d data-source.ts",
    "migration:show": "typeorm migration:show -d data-source.ts",
    "schema:sync": "typeorm schema:sync -d data-source.ts",
    "schema:drop": "typeorm schema:drop -d data-source.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "typeorm": "^0.3.17",
    "pg": "^8.11.0",
    "dotenv": "^16.3.0",
    "reflect-metadata": "^0.1.13"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}