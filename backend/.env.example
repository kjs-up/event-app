# Gateway Service Environment Configuration
# Copy this file to .env and customize the values

#==============================================================================
# APPLICATION SETTINGS
#==============================================================================

# Environment (development, staging, production)
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# API Configuration
API_PREFIX=/api/v1
API_VERSION=1.0.0

#==============================================================================
# DATABASE CONFIGURATION
#==============================================================================

# PostgreSQL Connection
DATABASE_URL=postgresql://eventuser:eventpass@localhost:5432/eventdb
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=eventuser
DATABASE_PASSWORD=eventpass
DATABASE_NAME=eventdb
DATABASE_SCHEMA=public

# Database Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=30000
DATABASE_IDLE_TIMEOUT=60000

# TypeORM Settings
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true
DATABASE_AUTO_LOAD_ENTITIES=true

#==============================================================================
# REDIS CONFIGURATION
#==============================================================================

# Redis Connection
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Session Configuration
SESSION_SECRET=your-session-secret-key-change-in-production
SESSION_TTL=86400

#==============================================================================
# JWT AUTHENTICATION
#==============================================================================

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-must-be-at-least-32-characters-long
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-jwt-refresh-secret-different-from-main-secret
JWT_REFRESH_EXPIRES_IN=7d

# Password Security
BCRYPT_SALT_ROUNDS=12

#==============================================================================
# API SECURITY
#==============================================================================

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Settings
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CORS_CREDENTIALS=true

# Security Headers
HELMET_ENABLED=true

#==============================================================================
# MICROSERVICES COMMUNICATION
#==============================================================================

# Service Discovery
USER_SERVICE_URL=http://localhost:3001
CUSTOMER_PORTAL_SERVICE_URL=http://localhost:3002
TICKET_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3004
ANALYTICS_SERVICE_URL=http://localhost:3005

# Service Authentication
SERVICE_API_KEY=internal-service-api-key-change-in-production

#==============================================================================
# WEBSOCKET CONFIGURATION
#==============================================================================

# WebSocket Settings
WS_PORT=3000
WS_PATH=/socket.io
WS_CORS_ORIGIN=http://localhost:5173,http://localhost:5174

#==============================================================================
# LOGGING & MONITORING
#==============================================================================

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/gateway.log

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

#==============================================================================
# DEVELOPMENT SETTINGS
#==============================================================================

# Debug Mode
DEBUG_ENABLED=true
DEBUG_NAMESPACE=gateway:*

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api/docs
SWAGGER_TITLE=Event Management Platform API
SWAGGER_DESCRIPTION=Comprehensive event management platform API

#==============================================================================
# EXTERNAL INTEGRATIONS
#==============================================================================

# Email Service (for notifications)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# File Upload
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# External API Keys (add as needed)
# STRIPE_SECRET_KEY=sk_test_...
# OMISE_SECRET_KEY=skey_test_...