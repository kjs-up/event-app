# Customer Portal Frontend Environment Configuration
# Copy this file to .env.local and customize the values

#==============================================================================
# API CONFIGURATION
#==============================================================================

# Backend API URL
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=10000

# WebSocket URL
VITE_WS_URL=ws://localhost:3000

#==============================================================================
# APPLICATION SETTINGS
#==============================================================================

# Application Info
VITE_APP_NAME=Event Management Platform - Customer Portal
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Customer portal for event registration and management

# Environment
VITE_NODE_ENV=development

#==============================================================================
# AUTHENTICATION
#==============================================================================

# Token Configuration
VITE_TOKEN_STORAGE_KEY=customer_access_token
VITE_REFRESH_TOKEN_KEY=customer_refresh_token
VITE_TOKEN_EXPIRY_BUFFER=300000

# Registration Settings
VITE_REGISTRATION_ENABLED=true
VITE_EMAIL_VERIFICATION_REQUIRED=true

#==============================================================================
# PAYMENT CONFIGURATION
#==============================================================================

# Payment Gateway UI Keys (public keys only)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_OMISE_PUBLISHABLE_KEY=pkey_test_your_omise_publishable_key

# Payment Settings
VITE_PAYMENT_CURRENCY=USD
VITE_PAYMENT_METHODS=credit_card,qr_code,bank_transfer

#==============================================================================
# EVENT FEATURES
#==============================================================================

# Event Discovery
VITE_SEARCH_ENABLED=true
VITE_FILTER_ENABLED=true
VITE_SORT_OPTIONS=date,name,price,popularity

# Registration Features
VITE_WAITLIST_ENABLED=true
VITE_GUEST_REGISTRATION=false
VITE_GROUP_REGISTRATION=true

# Notification Preferences
VITE_EMAIL_NOTIFICATIONS=true
VITE_SMS_NOTIFICATIONS=false
VITE_PUSH_NOTIFICATIONS=true

#==============================================================================
# UI/UX CONFIGURATION
#==============================================================================

# Theme Configuration
VITE_DEFAULT_THEME=light
VITE_THEME_PERSISTENCE=true

# Pagination
VITE_DEFAULT_PAGE_SIZE=12
VITE_MAX_PAGE_SIZE=48

# Real-time Updates
VITE_REALTIME_CAPACITY=true
VITE_REALTIME_NOTIFICATIONS=true

#==============================================================================
# FEATURE FLAGS
#==============================================================================

# Customer Features
VITE_PROFILE_MANAGEMENT=true
VITE_EVENT_HISTORY=true
VITE_FAVORITES=true

# Social Features
VITE_EVENT_SHARING=true
VITE_SOCIAL_LOGIN=false

# Support Features
VITE_LIVE_CHAT=false
VITE_HELP_CENTER=true

#==============================================================================
# EXTERNAL INTEGRATIONS
#==============================================================================

# Social Media Sharing
VITE_FACEBOOK_SHARE=true
VITE_TWITTER_SHARE=true
VITE_LINKEDIN_SHARE=true

# Maps Integration
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_MAPS_ENABLED=true

#==============================================================================
# DEVELOPMENT SETTINGS
#==============================================================================

# Debug Configuration
VITE_DEBUG_ENABLED=true
VITE_DEBUG_LEVEL=info

# Development Tools
VITE_MOCK_API=false
VITE_API_DELAY=0

# Error Tracking
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

#==============================================================================
# LOCALIZATION
#==============================================================================

# Language Settings
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,th
VITE_LANGUAGE_PERSISTENCE=true

# Regional Settings
VITE_DEFAULT_TIMEZONE=UTC
VITE_DATE_FORMAT=YYYY-MM-DD
VITE_CURRENCY_DISPLAY=symbol

#==============================================================================
# PERFORMANCE SETTINGS
#==============================================================================

# Caching
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000

# Image Optimization
VITE_IMAGE_LAZY_LOADING=true
VITE_IMAGE_COMPRESSION=true

#==============================================================================
# SECURITY SETTINGS
#==============================================================================

# Content Security
VITE_CSP_ENABLED=true
VITE_XSS_PROTECTION=true

# Privacy
VITE_ANALYTICS_ENABLED=false
VITE_COOKIE_CONSENT=true