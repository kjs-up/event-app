# Admin Portal Frontend Environment Configuration
# Copy this file to .env.local and customize the values

#==============================================================================
# API CONFIGURATION
#==============================================================================

# Backend API URL
VITE_API_URL=http://localhost:3000/api/v1
VITE_API_TIMEOUT=10000

# WebSocket URL
VITE_WS_URL=ws://localhost:3000

#==============================================================================
# APPLICATION SETTINGS
#==============================================================================

# Application Info
VITE_APP_NAME=Event Management Platform - Admin Portal
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Admin portal for event management

# Environment
VITE_NODE_ENV=development

#==============================================================================
# AUTHENTICATION
#==============================================================================

# Token Configuration
VITE_TOKEN_STORAGE_KEY=admin_access_token
VITE_REFRESH_TOKEN_KEY=admin_refresh_token
VITE_TOKEN_EXPIRY_BUFFER=300000

# Session Management
VITE_SESSION_TIMEOUT=1800000
VITE_IDLE_TIMEOUT=900000

#==============================================================================
# UI/UX CONFIGURATION
#==============================================================================

# Theme Configuration
VITE_DEFAULT_THEME=light
VITE_THEME_PERSISTENCE=true

# Pagination
VITE_DEFAULT_PAGE_SIZE=25
VITE_MAX_PAGE_SIZE=100

# Data Refresh Intervals
VITE_POLLING_INTERVAL=30000
VITE_REALTIME_ENABLED=true

#==============================================================================
# FEATURE FLAGS
#==============================================================================

# Analytics Features
VITE_ANALYTICS_ENABLED=true
VITE_ADVANCED_ANALYTICS=true

# Reporting Features
VITE_PDF_EXPORT_ENABLED=true
VITE_EXCEL_EXPORT_ENABLED=true

# Event Management Features
VITE_BULK_OPERATIONS=true
VITE_ADVANCED_FILTERING=true

# User Management Features
VITE_USER_IMPERSONATION=false
VITE_AUDIT_LOGS=true

#==============================================================================
# EXTERNAL INTEGRATIONS
#==============================================================================

# Payment Gateway UI Keys (public keys only)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_OMISE_PUBLISHABLE_KEY=pkey_test_your_omise_publishable_key

# Maps Integration
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

#==============================================================================
# DEVELOPMENT SETTINGS
#==============================================================================

# Debug Configuration
VITE_DEBUG_ENABLED=true
VITE_DEBUG_LEVEL=info

# Development Tools
VITE_MOCK_API=false
VITE_API_DELAY=0

# Error Tracking
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

#==============================================================================
# PERFORMANCE SETTINGS
#==============================================================================

# Caching
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000

# Lazy Loading
VITE_LAZY_LOADING=true
VITE_IMAGE_OPTIMIZATION=true

#==============================================================================
# LOCALIZATION
#==============================================================================

# Language Settings
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,th
VITE_LANGUAGE_PERSISTENCE=true

# Date/Time Format
VITE_DATE_FORMAT=YYYY-MM-DD
VITE_TIME_FORMAT=HH:mm
VITE_TIMEZONE=UTC

#==============================================================================
# SECURITY SETTINGS
#==============================================================================

# Content Security
VITE_CSP_ENABLED=true
VITE_XSS_PROTECTION=true

# API Security
VITE_API_KEY_HEADER=X-API-Key
VITE_REQUEST_TIMEOUT=30000